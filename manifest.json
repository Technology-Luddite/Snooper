{
  "manifest_version": 3,
  "name": "Snooper",
  "version": "3.8.0",
  "description": "Persistent browser fingerprint spoofing toolkit",

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "sidePanel",
    "cookies",
    "scripting",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "privacy",
    "management"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "action": {
    "default_title": "Snooper"
  },

  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/injector.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/modules/fingerprint-data/*.json"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/spy-icon-16.png",
    "32": "icons/spy-icon-32.png",
    "48": "icons/spy-icon-48.png",
    "128": "icons/spy-icon-128.png"
  }
}
